<?xml version="1.0" encoding="UTF-8"?>
<!--
  mvn-lens: JFR-based Maven build profiler, writing target/mvnlens/report.html at the end of every
  Maven session. https://github.com/mvn-perf/mvn-lens

  Only SNAPSHOTs are published so far, to the Maven Central snapshot repository
  (https://central.sonatype.com/repository/maven-snapshots/). Core extensions are resolved before
  the project POM is read, so that repository cannot be declared in pom.xml for this artifact:
  .mvn/pom.xml pre-resolves it into the local repository instead. On a clean machine, run once:

      cd .mvn && ../mvnw -U dependency:resolve

  See .mvn/pom.xml and .github/workflows/maven-build.yml.

  Pass -Dmvnlens.disabled=true to switch the profiler off for a single invocation.
-->
<!-- No xmlns on purpose: the project-wide nohttp check rejects the plain-http EXTENSIONS namespace URI. -->
<extensions>
  <extension>
    <groupId>io.github.mvn-perf</groupId>
    <artifactId>mvn-lens-extension</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </extension>
</extensions>
